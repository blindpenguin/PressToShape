<Project>
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Avalonia packages. Keep versions in sync. -->
        <PackageVersion Include="Avalonia" Version="12.1.6" />
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
        <PackageVersion Include="Avalonia.Android" Version="12.1.6" />
        <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />

        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

        <PackageVersion Include="Material.Icons.Avalonia" Version="3.0.2" />

        <PackageVersion Include="GetText.NET" Version="10.0.1" />

        <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />

        <!-- Developer tooling (tools/PressToShape.CodeIndex only) -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
        <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageVersion Include="Microsoft.Build.Framework" Version="18.7.1" />
        <PackageVersion Include="Microsoft.NET.StringTools" Version="18.7.1" />

        <!-- Developer tooling (tools/PressToShape.CursorImages only) -->
        <PackageVersion Include="SkiaSharp" Version="3.119.4" />
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />

        <!-- Testing -->
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    </ItemGroup>
</Project>
