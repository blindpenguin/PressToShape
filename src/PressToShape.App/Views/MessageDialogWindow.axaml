<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PressToShape.App.ViewModels"
        xmlns:views="using:PressToShape.App.Views"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="150"
        x:Class="PressToShape.App.Views.MessageDialogWindow"
        x:DataType="vm:MessageDialogViewModel"
        Title="{Binding Title}"
        Background="{DynamicResource WindowBackgroundBrush}"
        SizeToContent="WidthAndHeight"
        MinWidth="360" MaxWidth="560"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <views:MessageDialogView />

</Window>
