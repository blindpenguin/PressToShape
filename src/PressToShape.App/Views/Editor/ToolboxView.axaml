<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:PressToShape.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PressToShape.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PressToShape.App.ViewModels.Editor"
             xmlns:editor="using:PressToShape.App.Views.Editor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="96" d:DesignHeight="600"
             x:Class="PressToShape.App.Views.Editor.ToolboxView"
             x:DataType="vm:ToolboxViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="ToolButtonTemplate" DataType="vm:ToolItemViewModel">
            <controls:ToolToggleButton Classes="tool"
                          IsChecked="{Binding IsActive, Mode=OneWay}"
                          Command="{Binding SelectCommand}"
                          ToolTip.Tip="{Binding ToolTip}"
                          AutomationProperties.Name="{Binding Name}"
                          Margin="{DynamicResource ToolButtonMargin}">
                <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="{DynamicResource ToolIconSize}" Height="{DynamicResource ToolIconSize}" />
            </controls:ToolToggleButton>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource ToolColumnBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,1,0"
            Padding="{DynamicResource ToolColumnPadding}">
        <DockPanel>

            <editor:SwatchesView DockPanel.Dock="Bottom" />

            <!-- One column. Top keeps the rows at the top, not spread over the free height. -->
            <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource ToolButtonTemplate}" VerticalAlignment="Top" />

        </DockPanel>
    </Border>

</UserControl>
