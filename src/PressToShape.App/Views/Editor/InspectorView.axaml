<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:PressToShape.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PressToShape.App.ViewModels.Editor"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="800"
             x:Class="PressToShape.App.Views.Editor.InspectorView"
             x:DataType="vm:InspectorViewModel">

    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="Theme" Value="{StaticResource InspectorTabItemTheme}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="panel" BorderThickness="1,0,0,0">
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Padding="0">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabItem Header="{loc:T 'Properties'}" AutomationProperties.Name="{loc:T 'Properties tab'}">
                <ContentControl Content="{Binding Properties}" />
            </TabItem>
            <TabItem Header="{loc:T 'Layers'}" AutomationProperties.Name="{loc:T 'Layers tab'}">
                <ContentControl Content="{Binding Layers}" />
            </TabItem>
            <TabItem Header="{loc:T 'Objects'}" AutomationProperties.Name="{loc:T 'Objects tab'}">
                <ContentControl Content="{Binding Objects}" />
            </TabItem>
            <TabItem Header="{loc:T 'Assets'}" AutomationProperties.Name="{loc:T 'Assets tab'}">
                <ContentControl Content="{Binding Assets}" />
            </TabItem>
            <TabItem Header="{loc:T 'History'}" AutomationProperties.Name="{loc:T 'History tab'}">
                <ContentControl Content="{Binding History}" />
            </TabItem>
        </TabControl>
    </Border>

</UserControl>
