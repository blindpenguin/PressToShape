<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:PressToShape.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PressToShape.App.ViewModels.Editor"
             xmlns:controls="using:PressToShape.App.Controls"
             xmlns:local="using:PressToShape.App.Views.Editor"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="PressToShape.App.Views.Editor.CanvasAreaView"
             x:DataType="vm:CanvasAreaViewModel">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto">

        <!-- Corner between the rulers -->
        <Border Grid.Row="0" Grid.Column="0"
                IsVisible="{Binding ShowRulers}"
                Width="{StaticResource RulerSize}" Height="{StaticResource RulerSize}"
                Background="{DynamicResource RulerBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,1" />

        <controls:RulerControl x:Name="HorizontalRuler" Grid.Row="0" Grid.Column="1"
                               IsVisible="{Binding ShowRulers}"
                               Orientation="Horizontal"
                               Height="{StaticResource RulerSize}"
                               ZoomPercent="{Binding ZoomPercent}"
                               OriginPx="{Binding OriginX}" />

        <controls:RulerControl x:Name="VerticalRuler" Grid.Row="1" Grid.Column="0"
                               IsVisible="{Binding ShowRulers}"
                               Orientation="Vertical"
                               Width="{StaticResource RulerSize}"
                               ZoomPercent="{Binding ZoomPercent}"
                               OriginPx="{Binding OriginY}" />

        <!-- Viewport: canvas background, the centered artboard, and the drawn document on top. The panel takes the mouse and Delete key input. -->
        <Panel Grid.Row="1" Grid.Column="1"
               x:Name="Viewport"
               Focusable="True"
               Background="{DynamicResource CanvasBackgroundBrush}"
               ClipToBounds="True">
            <Canvas>
                <Border Canvas.Left="{Binding OriginX}"
                        Canvas.Top="{Binding OriginY}"
                        Width="{Binding ArtboardScreenWidth}"
                        Height="{Binding ArtboardScreenHeight}"
                        Background="{DynamicResource ArtboardFillBrush}"
                        BorderBrush="{DynamicResource ArtboardBorderBrush}"
                        BorderThickness="1" />
            </Canvas>
            <controls:DocumentCanvasControl IsHitTestVisible="False"
                                            Document="{Binding Document}"
                                            ZoomPercent="{Binding ZoomPercent}"
                                            OriginX="{Binding OriginX}"
                                            OriginY="{Binding OriginY}"
                                            Draft="{Binding Draft}"
                                            Overlay="{Binding Overlay}"
                                            PenOverlay="{Binding PenOverlay}"
                                            NodeOverlay="{Binding NodeOverlay}"
                                            HiddenShapeId="{Binding HiddenShapeId}"
                                            TextMeasurer="{Binding TextMeasurer}"
                                            EnteredGroupId="{Binding EnteredGroupId}"
                                            DimOpacity="{DynamicResource EnteredGroupDimOpacity}"
                                            HandleSize="{DynamicResource SelectionHandleSize}"
                                            ShowGrid="{Binding ShowGrid}"
                                            GridSpacing="{Binding GridSpacing}"
                                            GridBrush="{DynamicResource GridLineBrush}"
                                            SnapGuides="{Binding SnapGuidesOnScreen}"
                                            GuideBrush="{DynamicResource SnapGuideBrush}"
                                            RulerGuides="{Binding ScreenGuides}"
                                            SmartMarkers="{Binding ScreenMarkers}"
                                            RulerGuideBrush="{DynamicResource RulerGuideBrush}"
                                            RulerGuideSelectedBrush="{DynamicResource RulerGuideSelectedBrush}"
                                            RulerGuideActiveBrush="{DynamicResource RulerGuideActiveBrush}"
                                            SmartGuideBrush="{DynamicResource SmartGuideBrush}"
                                            SmartGuideTextBrush="{DynamicResource SmartGuideTextBrush}"
                                            SmartGuideLabelBackgroundBrush="{DynamicResource SmartGuideLabelBackgroundBrush}"
                                            SelectionBrush="{DynamicResource SelectionOutlineBrush}"
                                            SelectionHandleFillBrush="{DynamicResource SelectionHandleFillBrush}" />
            <!-- The editor of the text that is typed on the canvas. It sits over the canvas and is empty when no text is edited. -->
            <controls:TextEditorControl x:Name="TextEditor"
                                        Shape="{Binding EditedTextShape}"
                                        EditedText="{Binding EditedText}"
                                        LineHeight="{Binding EditedTextLineHeight}"
                                        CommitCommand="{Binding CommitTextEditCommand}"
                                        FallbackForeground="{DynamicResource SelectionOutlineBrush}"
                                        AutomationProperties.Name="{loc:T 'Text'}" />
            <!-- The ring context menu. It fills the viewport while it is open, so the canvas does not get pointer input then. -->
            <controls:RingMenuControl x:Name="RingMenu"
                                      DataContext="{Binding Ring}"
                                      InnerRadius="{DynamicResource RingInnerRadius}"
                                      OuterRadius="{DynamicResource RingOuterRadius}" />
        </Panel>

        <!-- Scroll bars. They sit outside the viewport, so the ruler zero stays aligned with the canvas.
             The value is one-way: the user's scrolling is forwarded in code-behind, so the bar can never write a coerced value back. -->
        <ScrollBar x:Name="VerticalBar"
                   Grid.Row="1" Grid.Column="2"
                   Orientation="Vertical"
                   Visibility="Visible" AllowAutoHide="False"
                   SmallChange="48"
                   Minimum="{Binding VerticalScrollMinimum}"
                   Maximum="{Binding VerticalScrollMaximum}"
                   ViewportSize="{Binding VerticalScrollViewportSize}"
                   LargeChange="{Binding VerticalScrollViewportSize}"
                   Value="{Binding VerticalScrollValue, Mode=OneWay}"
                   IsEnabled="{Binding CanScrollVertically}"
                   AutomationProperties.Name="{loc:T 'Vertical scroll bar'}" />

        <ScrollBar x:Name="HorizontalBar"
                   Grid.Row="2" Grid.Column="1"
                   Orientation="Horizontal"
                   Visibility="Visible" AllowAutoHide="False"
                   SmallChange="48"
                   Minimum="{Binding HorizontalScrollMinimum}"
                   Maximum="{Binding HorizontalScrollMaximum}"
                   ViewportSize="{Binding HorizontalScrollViewportSize}"
                   LargeChange="{Binding HorizontalScrollViewportSize}"
                   Value="{Binding HorizontalScrollValue, Mode=OneWay}"
                   IsEnabled="{Binding CanScrollHorizontally}"
                   AutomationProperties.Name="{loc:T 'Horizontal scroll bar'}" />

    </Grid>

</UserControl>
