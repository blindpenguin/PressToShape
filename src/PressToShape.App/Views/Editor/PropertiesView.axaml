<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:PressToShape.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PressToShape.App.ViewModels.Editor"
             xmlns:controls="using:PressToShape.App.Controls"
             xmlns:coreShapes="using:PressToShape.Core.Shapes"
             xmlns:local="using:PressToShape.App.Views.Editor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="800"
             x:Class="PressToShape.App.Views.Editor.PropertiesView"
             x:DataType="vm:PropertiesViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.swatchButton">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="{DynamicResource SwatchButtonMinSize}" />
            <Setter Property="MinWidth" Value="{DynamicResource SwatchButtonMinSize}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.smallSwatch">
            <Setter Property="Width" Value="{DynamicResource SmallSwatchSize}" />
            <Setter Property="Height" Value="{DynamicResource SmallSwatchSize}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="{DynamicResource PropertySwatchWidth}" />
            <Setter Property="Height" Value="{DynamicResource PropertySwatchHeight}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Classes="secondary" Text="{Binding Header}" Margin="12,10,12,6" IsVisible="{Binding ShowHeader}" />

            <TextBlock Classes="secondary" Text="{loc:T 'This tool has no properties.'}" Margin="12,10,12,12" TextWrapping="Wrap"
                       IsVisible="{Binding ShowNoPropertiesHint}" />

            <!-- The controls inside each section are disabled while nothing is selected.
                 The section headers stay enabled so sections can always be collapsed and expanded. -->
            <StackPanel>

                <controls:CollapsibleSection Header="{loc:T 'Transform'}" IsExpanded="{Binding IsTransformExpanded}" IsVisible="{Binding ShowTransform}">
                    <Grid Margin="12,4,12,12" ColumnDefinitions="Auto,*,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"
                          IsEnabled="{Binding HasSelection}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="X" Margin="0,0,6,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding X.Text}" IsEnabled="{Binding X.IsEnabled}" Tag="{Binding X}" AutomationProperties.Name="{loc:T 'X position'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
</TextBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="Y" Margin="8,0,6,0" />
                        <TextBox Grid.Row="0" Grid.Column="3" Classes="field" Text="{Binding Y.Text}" IsEnabled="{Binding Y.IsEnabled}" Tag="{Binding Y}" AutomationProperties.Name="{loc:T 'Y position'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
</TextBox>
                        <ToggleButton Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Classes="tool" Margin="8,0,0,0"
                                      IsChecked="{Binding KeepProportions}"
                                      ToolTip.Tip="{loc:T 'Keep proportions'}" AutomationProperties.Name="{loc:T 'Keep proportions'}">
                            <materialIcons:MaterialIcon Kind="LinkVariant" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                        </ToggleButton>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="W" Margin="0,0,6,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding Width.Text}" IsEnabled="{Binding Width.IsEnabled}" Tag="{Binding Width}" AutomationProperties.Name="{loc:T 'Width'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
</TextBox>
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="H" Margin="8,0,6,0" />
                        <TextBox Grid.Row="1" Grid.Column="3" Classes="field" Text="{Binding Height.Text}" IsEnabled="{Binding Height.IsEnabled}" Tag="{Binding Height}" AutomationProperties.Name="{loc:T 'Height'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
</TextBox>

                        <materialIcons:MaterialIcon Grid.Row="2" Grid.Column="0" Kind="RotateRight" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Classes="field" Text="{Binding Rotation.Text}" IsEnabled="{Binding Rotation.IsEnabled}" Tag="{Binding Rotation}" AutomationProperties.Name="{loc:T 'Rotation'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="°" /></TextBox.InnerRightContent>
</TextBox>
                        <Button Grid.Row="2" Grid.Column="4" Classes="icon" Margin="8,0,0,0"
                                Command="{Binding ResetTransformCommand}"
                                ToolTip.Tip="{loc:T 'Reset transform'}" AutomationProperties.Name="{loc:T 'Reset transform'}">
                            <materialIcons:MaterialIcon Kind="Restore" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                        </Button>
                    </Grid>
                </controls:CollapsibleSection>

                <controls:CollapsibleSection Header="{loc:T 'Appearance'}" IsExpanded="{Binding IsAppearanceExpanded}" IsVisible="{Binding ShowAppearance}">
                    <Grid Margin="12,4,12,12" ColumnDefinitions="100,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{loc:T 'Fill'}" />
                        <Button x:Name="FillSwatchButton" Grid.Row="0" Grid.Column="1" Classes="swatchButton" IsEnabled="{Binding Fill.IsEnabled}"
                                ToolTip.Tip="{loc:T 'Fill color'}" AutomationProperties.Name="{loc:T 'Fill color'}">
                            <Button.Flyout>
                                <Flyout Placement="LeftEdgeAlignedTop" Opened="OnFillFlyoutOpened" Closed="OnFillFlyoutClosed">
                                    <StackPanel Spacing="8">
                                        <ColorView x:Name="FillColorView" IsAlphaVisible="True" IsAlphaEnabled="True" IsHexInputVisible="True" HexInputAlphaPosition="Trailing"
                                                   ColorChanged="OnFillColorChanged" AutomationProperties.Name="{loc:T 'Fill color'}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="{loc:T 'Add to palette'}" Click="OnFillAddToPaletteClick" />
                                            <Button Content="{loc:T 'Pick from canvas'}" Click="OnFillPickClick" />
                                        </StackPanel>
                                        <TextBlock Classes="label" Text="{loc:T 'Recent colors'}" />
                                        <ItemsControl ItemsSource="{Binding RecentColors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" MaxWidth="260" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="coreShapes:Color">
                                                    <Button Classes="swatchButton" Click="OnFillRecentClick" ToolTip.Tip="{loc:T 'Recent colors'}" AutomationProperties.Name="{loc:T 'Recent colors'}">
                                                        <Border Classes="smallSwatch" Background="{Binding ., Converter={x:Static local:CoreColorBrushConverter.Instance}}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Panel>
                                <Border Classes="swatch" Background="{Binding Fill.Color, Converter={x:Static local:CoreColorBrushConverter.Instance}}"
                                        IsVisible="{Binding Fill.HasColor}" />
                                <Border Classes="swatch" Background="{DynamicResource ControlBackgroundBrush}" IsVisible="{Binding !Fill.HasColor}">
                                    <TextBlock Classes="unit" Margin="0" HorizontalAlignment="Center" Text="{loc:T 'Mixed'}" IsVisible="{Binding Fill.IsMixed}" />
                                </Border>
                            </Panel>
                        </Button>
                        <CheckBox Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Content="{loc:T 'None'}"
                                  IsChecked="{Binding Fill.IsNone, Mode=OneWay}" IsEnabled="{Binding Fill.IsEnabled}"
                                  Click="OnFillNoneClick" AutomationProperties.Name="{loc:T 'No fill'}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{loc:T 'Stroke'}" />
                        <Button x:Name="StrokeSwatchButton" Grid.Row="1" Grid.Column="1" Classes="swatchButton" IsEnabled="{Binding Stroke.IsEnabled}"
                                ToolTip.Tip="{loc:T 'Stroke color'}" AutomationProperties.Name="{loc:T 'Stroke color'}">
                            <Button.Flyout>
                                <Flyout Placement="LeftEdgeAlignedTop" Opened="OnStrokeFlyoutOpened" Closed="OnStrokeFlyoutClosed">
                                    <StackPanel Spacing="8">
                                        <ColorView x:Name="StrokeColorView" IsAlphaVisible="True" IsAlphaEnabled="True" IsHexInputVisible="True" HexInputAlphaPosition="Trailing"
                                                   ColorChanged="OnStrokeColorChanged" AutomationProperties.Name="{loc:T 'Stroke color'}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="{loc:T 'Add to palette'}" Click="OnStrokeAddToPaletteClick" />
                                            <Button Content="{loc:T 'Pick from canvas'}" Click="OnStrokePickClick" />
                                        </StackPanel>
                                        <TextBlock Classes="label" Text="{loc:T 'Recent colors'}" />
                                        <ItemsControl ItemsSource="{Binding RecentColors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" MaxWidth="260" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="coreShapes:Color">
                                                    <Button Classes="swatchButton" Click="OnStrokeRecentClick" ToolTip.Tip="{loc:T 'Recent colors'}" AutomationProperties.Name="{loc:T 'Recent colors'}">
                                                        <Border Classes="smallSwatch" Background="{Binding ., Converter={x:Static local:CoreColorBrushConverter.Instance}}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Panel>
                                <Border Classes="swatch" Background="{Binding Stroke.Color, Converter={x:Static local:CoreColorBrushConverter.Instance}}"
                                        IsVisible="{Binding Stroke.HasColor}" />
                                <Border Classes="swatch" Background="{DynamicResource ControlBackgroundBrush}" IsVisible="{Binding !Stroke.HasColor}">
                                    <TextBlock Classes="unit" Margin="0" HorizontalAlignment="Center" Text="{loc:T 'Mixed'}" IsVisible="{Binding Stroke.IsMixed}" />
                                </Border>
                            </Panel>
                        </Button>
                        <CheckBox Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Content="{loc:T 'None'}"
                                  IsChecked="{Binding Stroke.IsNone, Mode=OneWay}" IsEnabled="{Binding Stroke.IsEnabled}"
                                  Click="OnStrokeNoneClick" AutomationProperties.Name="{loc:T 'No stroke'}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{loc:T 'Stroke width'}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="field" Width="96" HorizontalAlignment="Left"
                                 Text="{Binding StrokeWidth.Text}" IsEnabled="{Binding StrokeWidth.IsEnabled}" Tag="{Binding StrokeWidth}"
                                 AutomationProperties.Name="{loc:T 'Stroke width'}">
                            <TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
                        </TextBox>

                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="2">
                            <Button Classes="icon" IsEnabled="False" ToolTip.Tip="{loc:T 'Stroke cap'}" AutomationProperties.Name="{loc:T 'Stroke cap'}">
                                <materialIcons:MaterialIcon Kind="VectorLine" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                            </Button>
                            <Button Classes="icon" IsEnabled="False" ToolTip.Tip="{loc:T 'Stroke join'}" AutomationProperties.Name="{loc:T 'Stroke join'}">
                                <materialIcons:MaterialIcon Kind="VectorPolyline" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                            </Button>
                            <Button Classes="icon" IsEnabled="False" ToolTip.Tip="{loc:T 'Stroke alignment'}" AutomationProperties.Name="{loc:T 'Stroke alignment'}">
                                <materialIcons:MaterialIcon Kind="FormatLineStyle" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                            </Button>
                            <Button Classes="icon" IsEnabled="False" ToolTip.Tip="{loc:T 'Dashes'}" AutomationProperties.Name="{loc:T 'Dashes'}">
                                <materialIcons:MaterialIcon Kind="Equal" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="{loc:T 'Palette'}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <Panel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
                            <ItemsControl x:Name="PaletteStrip" ItemsSource="{Binding Palette.Swatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="coreShapes:Color">
                                        <Button Classes="swatchButton" Click="OnSwatchClick" ToolTip.Tip="{loc:T 'Swatch'}" AutomationProperties.Name="{loc:T 'Swatch'}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:T 'Remove swatch'}" Click="OnRemoveSwatchClick" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Border Classes="smallSwatch" Background="{Binding ., Converter={x:Static local:CoreColorBrushConverter.Instance}}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="secondary" Text="{loc:T 'No swatches yet.'}" IsVisible="{Binding Palette.IsEmpty}" />
                        </Panel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="{loc:T 'Opacity'}" />
                        <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                            <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="0" Maximum="100"
                                    Value="{Binding OpacitySliderValue, Mode=OneWay}" IsEnabled="{Binding OpacityPercent.IsEnabled}"
                                    AutomationProperties.Name="{loc:T 'Opacity'}" />
                            <TextBox Grid.Column="1" Classes="field" Width="72" Margin="8,0,0,0"
                                     Text="{Binding OpacityPercent.Text}" IsEnabled="{Binding OpacityPercent.IsEnabled}" Tag="{Binding OpacityPercent}"
                                     AutomationProperties.Name="{loc:T 'Opacity percent'}">
                                <TextBox.InnerRightContent><TextBlock Classes="unit" Text="%" /></TextBox.InnerRightContent>
                            </TextBox>
                        </Grid>
                    </Grid>
                </controls:CollapsibleSection>

                <controls:CollapsibleSection Header="{loc:T 'Path'}" IsExpanded="{Binding IsPathExpanded}" IsVisible="{Binding ShowPath}">
                    <StackPanel Margin="12,4,12,12" Spacing="8">
                        <TextBlock Classes="secondary" Text="{loc:T 'Path options appear when a path is selected.'}"
                                   TextWrapping="Wrap" IsVisible="{Binding !HasPathSelected}" />
                        <StackPanel Spacing="8" IsVisible="{Binding HasPathSelected}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="choice" Classes.selected="{Binding IsPathOpen}" Command="{Binding OpenPathCommand}"
                                        Content="{loc:T 'Open path'}" AutomationProperties.Name="{loc:T 'Open path'}" />
                                <Button Classes="choice" Classes.selected="{Binding IsPathClosed}" Command="{Binding ClosePathCommand}"
                                        Content="{loc:T 'Closed path'}" AutomationProperties.Name="{loc:T 'Closed path'}" />
                            </StackPanel>
                            <TextBlock Classes="label" Text="{loc:T 'Fill rule'}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="choice" Classes.selected="{Binding IsFillRuleNonZero}" Command="{Binding UseNonZeroFillCommand}"
                                        Content="{loc:T 'Non-zero'}" AutomationProperties.Name="{loc:T 'Non-zero'}" />
                                <Button Classes="choice" Classes.selected="{Binding IsFillRuleEvenOdd}" Command="{Binding UseEvenOddFillCommand}"
                                        Content="{loc:T 'Even-odd'}" AutomationProperties.Name="{loc:T 'Even-odd'}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </controls:CollapsibleSection>

                <controls:CollapsibleSection Header="{loc:T 'Node'}" IsExpanded="{Binding IsNodeExpanded}" IsVisible="{Binding ShowNode}">
                    <StackPanel Margin="12,4,12,12" Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="X" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Classes="field" Text="{Binding NodeX.Text}" IsEnabled="{Binding NodeX.IsEnabled}" Tag="{Binding NodeX}"
                                     AutomationProperties.Name="{loc:T 'Node X position'}">
                                <TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
                            </TextBox>
                            <TextBlock Grid.Column="2" Classes="label" Text="Y" Margin="8,0,6,0" />
                            <TextBox Grid.Column="3" Classes="field" Text="{Binding NodeY.Text}" IsEnabled="{Binding NodeY.IsEnabled}" Tag="{Binding NodeY}"
                                     AutomationProperties.Name="{loc:T 'Node Y position'}">
                                <TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
                            </TextBox>
                        </Grid>
                        <StackPanel Spacing="8" IsVisible="{Binding ShowNodeTypeTools}">
                            <TextBlock Classes="label" Text="{loc:T 'Node type'}" />
                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                                <Button Classes="choice" Classes.selected="{Binding IsNodeCorner}" Command="{Binding MakeNodeCornerCommand}"
                                        Content="{loc:T 'Corner'}" AutomationProperties.Name="{loc:T 'Corner'}" />
                                <Button Classes="choice" Classes.selected="{Binding IsNodeSmooth}" Command="{Binding MakeNodeSmoothCommand}"
                                        Content="{loc:T 'Smooth'}" AutomationProperties.Name="{loc:T 'Smooth'}" />
                                <Button Classes="choice" Classes.selected="{Binding IsNodeSymmetric}" Command="{Binding MakeNodeSymmetricCommand}"
                                        Content="{loc:T 'Symmetric'}" AutomationProperties.Name="{loc:T 'Symmetric'}" />
                            </WrapPanel>
                            <TextBlock Classes="label" Text="{loc:T 'Segment'}" />
                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                                <Button Classes="choice" Command="{Binding MakeSegmentStraightCommand}"
                                        Content="{loc:T 'Straight segment'}" AutomationProperties.Name="{loc:T 'Straight segment'}" />
                                <Button Classes="choice" Command="{Binding MakeSegmentCurvedCommand}"
                                        Content="{loc:T 'Curved segment'}" AutomationProperties.Name="{loc:T 'Curved segment'}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </controls:CollapsibleSection>

                <controls:CollapsibleSection Header="{loc:T 'Align &amp; Distribute'}" IsExpanded="{Binding IsAlignExpanded}" IsVisible="{Binding ShowAlign}">
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="12,4,12,12" IsEnabled="{Binding HasSelection}">
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Left'}" AutomationProperties.Name="{loc:T 'Align Left'}">
                            <materialIcons:MaterialIcon Kind="AlignHorizontalLeft" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Center'}" AutomationProperties.Name="{loc:T 'Align Center'}">
                            <materialIcons:MaterialIcon Kind="AlignHorizontalCenter" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Right'}" AutomationProperties.Name="{loc:T 'Align Right'}">
                            <materialIcons:MaterialIcon Kind="AlignHorizontalRight" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Distribute horizontally'}" AutomationProperties.Name="{loc:T 'Distribute horizontally'}">
                            <materialIcons:MaterialIcon Kind="DistributeHorizontalCenter" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                        </Button>
                        <Border Width="1" Margin="6,6" Background="{DynamicResource BorderSubtleBrush}" />
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Top'}" AutomationProperties.Name="{loc:T 'Align Top'}">
                            <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Middle'}" AutomationProperties.Name="{loc:T 'Align Middle'}">
                            <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Bottom'}" AutomationProperties.Name="{loc:T 'Align Bottom'}">
                            <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                        </Button>
                    </StackPanel>
                </controls:CollapsibleSection>

                <controls:CollapsibleSection Header="{loc:T 'Quick Actions'}" IsExpanded="{Binding IsQuickActionsExpanded}" IsVisible="{Binding ShowQuickActions}">
                    <WrapPanel Margin="12,4,12,12" ItemSpacing="6" LineSpacing="6" IsEnabled="{Binding HasSelection}">
                        <Button Content="{loc:T 'Group'}" Command="{Binding GroupCommand}" MinWidth="80" HorizontalContentAlignment="Center" />
                        <Button Content="{loc:T 'Ungroup'}" Command="{Binding UngroupCommand}" MinWidth="80" HorizontalContentAlignment="Center" />
                        <Button Content="{loc:T 'Mask'}" MinWidth="80" HorizontalContentAlignment="Center" />
                    </WrapPanel>
                </controls:CollapsibleSection>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
