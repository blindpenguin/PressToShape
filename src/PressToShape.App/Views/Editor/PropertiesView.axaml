<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:PressToShape.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PressToShape.App.ViewModels.Editor"
             xmlns:controls="using:PressToShape.App.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="800"
             x:Class="PressToShape.App.Views.Editor.PropertiesView"
             x:DataType="vm:PropertiesViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Classes="secondary" Text="{loc:T 'Nothing selected'}" Margin="12,10,12,6"
                       IsVisible="{Binding ShowNothingSelectedHint}" />

            <!-- The controls inside each section are disabled while nothing is selected.
                 The section headers stay enabled so sections can always be collapsed and expanded. -->
            <StackPanel>

                <controls:CollapsibleSection Header="{loc:T 'Transform'}" IsExpanded="{Binding IsTransformExpanded}">
                    <Grid Margin="12,4,12,12" ColumnDefinitions="Auto,*,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"
                          IsEnabled="{Binding HasSelection}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="X" Margin="0,0,6,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" Classes="field" AutomationProperties.Name="{loc:T 'X position'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
</TextBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="Y" Margin="8,0,6,0" />
                        <TextBox Grid.Row="0" Grid.Column="3" Classes="field" AutomationProperties.Name="{loc:T 'Y position'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
</TextBox>
                        <ToggleButton Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Classes="tool" Margin="8,0,0,0"
                                      ToolTip.Tip="{loc:T 'Keep proportions'}" AutomationProperties.Name="{loc:T 'Keep proportions'}">
                            <materialIcons:MaterialIcon Kind="LinkVariant" Width="18" Height="18" />
                        </ToggleButton>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="W" Margin="0,0,6,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="field" AutomationProperties.Name="{loc:T 'Width'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
</TextBox>
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="H" Margin="8,0,6,0" />
                        <TextBox Grid.Row="1" Grid.Column="3" Classes="field" AutomationProperties.Name="{loc:T 'Height'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
</TextBox>

                        <materialIcons:MaterialIcon Grid.Row="2" Grid.Column="0" Kind="RotateRight" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Classes="field" AutomationProperties.Name="{loc:T 'Rotation'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="°" /></TextBox.InnerRightContent>
</TextBox>
                        <Button Grid.Row="2" Grid.Column="4" Classes="icon" Margin="8,0,0,0"
                                ToolTip.Tip="{loc:T 'Reset transform'}" AutomationProperties.Name="{loc:T 'Reset transform'}">
                            <materialIcons:MaterialIcon Kind="Restore" Width="18" Height="18" />
                        </Button>
                    </Grid>
                </controls:CollapsibleSection>

                <controls:CollapsibleSection Header="{loc:T 'Appearance'}" IsExpanded="{Binding IsAppearanceExpanded}">
                    <Grid Margin="12,4,12,12" ColumnDefinitions="64,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8"
                          IsEnabled="{Binding HasSelection}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{loc:T 'Fill'}" />
                        <Border Grid.Row="0" Grid.Column="1" Classes="swatch" Background="{DynamicResource AppAccentBrush}" />
                        <Button Grid.Row="0" Grid.Column="2" Classes="icon" ToolTip.Tip="{loc:T 'Fill options'}" AutomationProperties.Name="{loc:T 'Fill options'}">
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" />
                        </Button>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{loc:T 'Stroke'}" />
                        <Border Grid.Row="1" Grid.Column="1" Classes="swatch" Background="{DynamicResource ControlBackgroundBrush}" />
                        <Button Grid.Row="1" Grid.Column="2" Classes="icon" ToolTip.Tip="{loc:T 'Stroke options'}" AutomationProperties.Name="{loc:T 'Stroke options'}">
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" />
                        </Button>
                        <TextBox Grid.Row="1" Grid.Column="3" Classes="field" Margin="8,0,0,0" AutomationProperties.Name="{loc:T 'Stroke width'}">
<TextBox.InnerRightContent><TextBlock Classes="unit" Text="px" /></TextBox.InnerRightContent>
</TextBox>

                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="2">
                            <Button Classes="icon" ToolTip.Tip="{loc:T 'Stroke cap'}" AutomationProperties.Name="{loc:T 'Stroke cap'}">
                                <materialIcons:MaterialIcon Kind="VectorLine" Width="18" Height="18" />
                            </Button>
                            <Button Classes="icon" ToolTip.Tip="{loc:T 'Stroke join'}" AutomationProperties.Name="{loc:T 'Stroke join'}">
                                <materialIcons:MaterialIcon Kind="VectorPolyline" Width="18" Height="18" />
                            </Button>
                            <Button Classes="icon" ToolTip.Tip="{loc:T 'Stroke alignment'}" AutomationProperties.Name="{loc:T 'Stroke alignment'}">
                                <materialIcons:MaterialIcon Kind="FormatLineStyle" Width="18" Height="18" />
                            </Button>
                            <Button Classes="icon" ToolTip.Tip="{loc:T 'Dashes'}" AutomationProperties.Name="{loc:T 'Dashes'}">
                                <materialIcons:MaterialIcon Kind="Equal" Width="18" Height="18" />
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{loc:T 'Opacity'}" />
                        <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
                            <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="100" AutomationProperties.Name="{loc:T 'Opacity'}" />
                            <TextBox Grid.Column="1" Classes="field" Width="64" Text="100%" Margin="8,0,0,0"
                                     AutomationProperties.Name="{loc:T 'Opacity percent'}" />
                        </Grid>
                    </Grid>
                </controls:CollapsibleSection>

                <controls:CollapsibleSection Header="{loc:T 'Path'}" IsExpanded="{Binding IsPathExpanded}">
                    <TextBlock Classes="secondary" Text="{loc:T 'Path options appear when a path is selected.'}"
                               Margin="12,4,12,12" TextWrapping="Wrap" />
                </controls:CollapsibleSection>

                <controls:CollapsibleSection Header="{loc:T 'Align &amp; Distribute'}" IsExpanded="{Binding IsAlignExpanded}">
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="12,4,12,12" IsEnabled="{Binding HasSelection}">
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Left'}" AutomationProperties.Name="{loc:T 'Align Left'}">
                            <materialIcons:MaterialIcon Kind="AlignHorizontalLeft" Width="18" Height="18" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Center'}" AutomationProperties.Name="{loc:T 'Align Center'}">
                            <materialIcons:MaterialIcon Kind="AlignHorizontalCenter" Width="18" Height="18" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Right'}" AutomationProperties.Name="{loc:T 'Align Right'}">
                            <materialIcons:MaterialIcon Kind="AlignHorizontalRight" Width="18" Height="18" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Distribute horizontally'}" AutomationProperties.Name="{loc:T 'Distribute horizontally'}">
                            <materialIcons:MaterialIcon Kind="DistributeHorizontalCenter" Width="18" Height="18" />
                        </Button>
                        <Border Width="1" Margin="6,6" Background="{DynamicResource BorderSubtleBrush}" />
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Top'}" AutomationProperties.Name="{loc:T 'Align Top'}">
                            <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="18" Height="18" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Middle'}" AutomationProperties.Name="{loc:T 'Align Middle'}">
                            <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="18" Height="18" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{loc:T 'Align Bottom'}" AutomationProperties.Name="{loc:T 'Align Bottom'}">
                            <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </controls:CollapsibleSection>

                <controls:CollapsibleSection Header="{loc:T 'Quick Actions'}" IsExpanded="{Binding IsQuickActionsExpanded}">
                    <WrapPanel Margin="12,4,12,12" ItemSpacing="6" LineSpacing="6" IsEnabled="{Binding HasSelection}">
                        <Button Content="{loc:T 'Group'}" MinWidth="80" HorizontalContentAlignment="Center" />
                        <Button Content="{loc:T 'Ungroup'}" MinWidth="80" HorizontalContentAlignment="Center" />
                        <Button Content="{loc:T 'Mask'}" MinWidth="80" HorizontalContentAlignment="Center" />
                    </WrapPanel>
                </controls:CollapsibleSection>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
