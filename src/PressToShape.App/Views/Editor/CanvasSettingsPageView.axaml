<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:PressToShape.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PressToShape.App.ViewModels.Editor"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
             x:Class="PressToShape.App.Views.Editor.CanvasSettingsPageView"
             x:DataType="vm:CanvasSettingsPageViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource SettingsPagePadding}" Spacing="{DynamicResource SettingsRowSpacing}">

            <TextBlock Classes="section-header" Text="{loc:T 'Canvas'}" />

            <CheckBox Classes="setting" Content="{loc:T 'Show rulers'}" IsChecked="{Binding Settings.ShowRulers}" />
            <CheckBox Classes="setting" Content="{loc:T 'Show grid'}" IsChecked="{Binding Settings.ShowGrid}" />

            <StackPanel Spacing="4">
                <TextBlock Classes="secondary" Text="{loc:T 'Grid spacing'}" />
                <TextBox x:Name="GridSpacingBox" Classes="field" HorizontalAlignment="Left" Width="{DynamicResource SettingsFieldWidth}"
                         Text="{Binding Settings.GridSpacingText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:T 'Grid spacing'}">
                    <TextBox.InnerRightContent>
                        <TextBlock Classes="unit" Text="px" />
                    </TextBox.InnerRightContent>
                </TextBox>
                <TextBlock Classes="error" Text="{Binding Settings.GridSpacingError}" IsVisible="{Binding Settings.HasGridSpacingError}" />
            </StackPanel>

            <Button Classes="dialogButton" HorizontalAlignment="Left" Content="{loc:T 'Restore defaults'}"
                    Command="{Binding Settings.RestoreDefaultsCommand}" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
