<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:PressToShape.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PressToShape.App.ViewModels.Editor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="PressToShape.App.Views.Editor.LayersView"
             x:DataType="vm:LayersViewModel">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="{StaticResource PanelPadding}">

        <!-- Header: title, add layer, more options -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Classes="section-header" Text="{loc:T 'Layers'}" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding AddLayerCommand}"
                    ToolTip.Tip="{loc:T 'Add layer'}" AutomationProperties.Name="{loc:T 'Add layer'}">
                <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" />
            </Button>
            <Button Grid.Column="2" Classes="icon" IsEnabled="False"
                    ToolTip.Tip="{loc:T 'More options'}" AutomationProperties.Name="{loc:T 'More layer options'}">
                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
            </Button>
        </Grid>

        <!-- Layer list, topmost layer first: layers icon, name, lock toggle, visibility toggle -->
        <ListBox ItemsSource="{Binding Items}" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:LayerItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="28">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="LayersOutline" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Classes="icon" Command="{Binding ToggleLockCommand}"
                                MinWidth="28" MinHeight="28"
                                ToolTip.Tip="{loc:T 'Toggle lock'}" AutomationProperties.Name="{loc:T 'Toggle lock'}">
                            <Panel>
                                <materialIcons:MaterialIcon Kind="LockOutline" Width="16" Height="16" IsVisible="{Binding IsLocked}" />
                                <materialIcons:MaterialIcon Kind="LockOpenVariantOutline" Width="16" Height="16" IsVisible="{Binding !IsLocked}" />
                            </Panel>
                        </Button>
                        <Button Grid.Column="3" Classes="icon" Command="{Binding ToggleVisibilityCommand}"
                                MinWidth="28" MinHeight="28"
                                ToolTip.Tip="{loc:T 'Toggle visibility'}" AutomationProperties.Name="{loc:T 'Toggle visibility'}">
                            <Panel>
                                <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16" IsVisible="{Binding IsVisible}" />
                                <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16" IsVisible="{Binding !IsVisible}" />
                            </Panel>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</UserControl>
