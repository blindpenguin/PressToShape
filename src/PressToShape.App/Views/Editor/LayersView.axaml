<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PressToShape.App.ViewModels.Editor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="PressToShape.App.Views.Editor.LayersView"
             x:DataType="vm:LayersViewModel">

    <UserControl.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:LayerItemViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="{StaticResource PanelPadding}">

        <!-- Header: title, add layer, more options -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Classes="section-header" Text="Layers" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding AddLayerCommand}"
                    ToolTip.Tip="Add layer" AutomationProperties.Name="Add layer">
                <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" />
            </Button>
            <Button Grid.Column="2" Classes="icon" IsEnabled="False"
                    ToolTip.Tip="More options" AutomationProperties.Name="More layer options">
                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="18" Height="18" />
            </Button>
        </Grid>

        <!-- Empty state -->
        <TextBlock Classes="secondary" Text="No layers yet"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !HasLayers}" />

        <!-- Layer tree: expand arrow (groups), icon, name, visibility toggle -->
        <TreeView ItemsSource="{Binding Items}" IsVisible="{Binding HasLayers}" Background="Transparent">
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:LayerItemViewModel" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="28">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="icon" Command="{Binding ToggleVisibilityCommand}"
                                MinWidth="28" MinHeight="28"
                                ToolTip.Tip="Toggle visibility" AutomationProperties.Name="Toggle visibility">
                            <Panel>
                                <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16" IsVisible="{Binding IsVisible}" />
                                <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16" IsVisible="{Binding !IsVisible}" />
                            </Panel>
                        </Button>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

    </DockPanel>

</UserControl>
