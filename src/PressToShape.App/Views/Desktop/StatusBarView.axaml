<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:PressToShape.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PressToShape.App.ViewModels.Editor"
             xmlns:editor="using:PressToShape.App.ViewModels.Editor"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="28"
             x:Class="PressToShape.App.Views.Desktop.StatusBarView"
             x:DataType="vm:StatusBarViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon.small">
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Height="{StaticResource StatusBarHeight}"
            Padding="12,0,8,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">

            <TextBlock Grid.Column="0" Classes="status" Text="{Binding SelectionSummary}" />
            <TextBlock Grid.Column="1" Classes="status" Margin="16,0,0,0"
                       Text="{Binding PathLengthText}" IsVisible="{Binding ShowPathLength}" />
            <TextBlock Grid.Column="2" Classes="status" Margin="16,0,0,0"
                       Text="{Binding BusyText}" IsVisible="{Binding IsBusy}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <ToggleButton Classes="snap" IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                              MinWidth="24" MinHeight="24"
                              ToolTip.Tip="{loc:T 'Show Grid'}" AutomationProperties.Name="{loc:T 'Show Grid'}">
                    <materialIcons:MaterialIcon Kind="GridLarge" Width="16" Height="16" />
                </ToggleButton>
                <ToggleButton Classes="snap" IsChecked="{Binding SnapToGrid, Mode=TwoWay}"
                              MinWidth="24" MinHeight="24"
                              ToolTip.Tip="{loc:T 'Snap to Grid'}" AutomationProperties.Name="{loc:T 'Snap to Grid'}">
                    <materialIcons:MaterialIcon Kind="DotsGrid" Width="16" Height="16" />
                </ToggleButton>
                <ToggleButton Classes="snap" IsChecked="{Binding SnapToObjects, Mode=TwoWay}"
                              MinWidth="24" MinHeight="24"
                              ToolTip.Tip="{loc:T 'Snap to Objects'}" AutomationProperties.Name="{loc:T 'Snap to Objects'}">
                    <materialIcons:MaterialIcon Kind="Magnet" Width="16" Height="16" />
                </ToggleButton>
                <TextBox x:Name="GridSpacingBox" Classes="field" Width="64" MinHeight="24" Height="24" Margin="0,0,12,0"
                         Text="{Binding GridSpacingField.Text}" IsEnabled="{Binding GridSpacingField.IsEnabled}" Tag="{Binding GridSpacingField}"
                         ToolTip.Tip="{loc:T 'Grid Spacing'}" AutomationProperties.Name="{loc:T 'Grid Spacing'}">
                    <TextBox.InnerRightContent>
                        <TextBlock Classes="unit" Text="px" />
                    </TextBox.InnerRightContent>
                </TextBox>
                <Button Classes="icon small" Command="{Binding ActivateHandToolCommand}"
                        ToolTip.Tip="{loc:T 'Pan (Hand tool)'}" AutomationProperties.Name="{loc:T 'Pan (Hand tool)'}">
                    <materialIcons:MaterialIcon Kind="HandBackLeftOutline" Width="16" Height="16" />
                </Button>
                <Button Classes="icon small" Command="{Binding ZoomOutCommand}"
                        ToolTip.Tip="{loc:T 'Zoom out'}" AutomationProperties.Name="{loc:T 'Zoom out'}">
                    <materialIcons:MaterialIcon Kind="MinusThick" Width="14" Height="14" />
                </Button>

                <DropDownButton Content="{Binding ZoomText}"
                                MinWidth="72"
                                Padding="8,0"
                                Height="24"
                                FontSize="12"
                                ToolTip.Tip="{loc:T 'Zoom'}"
                                AutomationProperties.Name="{loc:T 'Zoom level'}">
                    <DropDownButton.Flyout>
                        <MenuFlyout ItemsSource="{Binding ZoomPresets}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem"
                                              BasedOn="{StaticResource {x:Type MenuItem}}"
                                              x:DataType="editor:ZoomPresetViewModel">
                                    <Setter Property="Header" Value="{Binding Text}" />
                                    <Setter Property="Command" Value="{Binding SelectCommand}" />
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button Classes="icon small" Command="{Binding ZoomInCommand}"
                        ToolTip.Tip="{loc:T 'Zoom in'}" AutomationProperties.Name="{loc:T 'Zoom in'}">
                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                </Button>
                <Button Classes="icon small" Command="{Binding FitToWindowCommand}"
                        ToolTip.Tip="{loc:T 'Fit artboard in window'}" AutomationProperties.Name="{loc:T 'Fit artboard in window'}">
                    <materialIcons:MaterialIcon Kind="FitToScreen" Width="16" Height="16" />
                </Button>
            </StackPanel>

        </Grid>
    </Border>

</UserControl>
