<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PressToShape.App.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <!-- Control styles for the editor shell. Colors and sizes come from Theme.axaml only. -->

    <Styles.Resources>
        <!-- Flat inspector tab: label, a 2 px accent line when selected, hairline under the strip -->
        <ControlTheme x:Key="InspectorTabItemTheme" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_LayoutRoot"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid RowDefinitions="*,2">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Grid.Row="0"
                                              Padding="2,10"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center" />
                            <Border Name="PART_SelectedPipe"
                                    Grid.Row="1"
                                    Background="{DynamicResource AppAccentBrush}"
                                    IsVisible="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
            <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type controls:CollapsibleSection}" TargetType="controls:CollapsibleSection">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <ToggleButton Classes="section-toggle"
                                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding Header}"
                                                      FontSize="{DynamicResource SectionHeaderFontSize}"
                                                      FontWeight="SemiBold"
                                                      VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Classes="expanded" Kind="ChevronUp" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                                        <materialIcons:MaterialIcon Classes="collapsed" Kind="ChevronDown" Width="{DynamicResource PanelIconSize}" Height="{DynamicResource PanelIconSize}" />
                                    </Panel>
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              IsVisible="{TemplateBinding IsExpanded}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- Plain icon button (toolbar, panels) -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="{DynamicResource ToolbarButtonSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource ToolbarButtonSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Tool toggle (tool column and toolbar tool toggles): accent background when active -->
    <Style Selector="ToggleButton.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{DynamicResource ToolButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource ToolButtonSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Switch button (status bar: grid, snap to grid, snap to objects): like a tool toggle, but the layout sets its size -->
    <Style Selector="ToggleButton.snap">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.snap:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.snap:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.snap:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Choice button: one of a row of buttons that stands for a setting. The one that is set has the accent background -->
    <Style Selector="Button.choice">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style Selector="Button.choice.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.choice.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Collapsible section: the whole header row is a toggle button -->
    <Style Selector="ToggleButton.section-toggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.section-toggle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.section-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.section-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.section-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.section-toggle:checked materialIcons|MaterialIcon.collapsed">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.section-toggle:not(:checked) materialIcons|MaterialIcon.expanded">
        <Setter Property="IsVisible" Value="False" />
    </Style>



    <!-- Panel surfaces and section headers -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="{DynamicResource SectionHeaderFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- The buttons of the settings (OK, Cancel, Restore defaults) and its switches: content centered, also in the taller touch size. -->
    <Style Selector="Button.dialogButton">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The box of a CheckBox stays at the top of its 32 px area, also when the touch size makes the control taller. The label is put next to the box with it. -->
    <Style Selector="CheckBox.setting">
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="8,5,0,0" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Numeric/text field with an optional suffix such as "px" (set InnerRightContent). The suffix gets space to the border. -->
    <Style Selector="TextBlock.unit">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBox.field">
        <Setter Property="MinHeight" Value="{DynamicResource FieldHeight}" />
        <Setter Property="Height" Value="{DynamicResource FieldHeight}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
    </Style>

    <!--
        The editor of a text on the canvas (Controls/TextEditorControl): the box has no border, background or padding of its own, in every
        state, so only the text and its caret show. A thin outline of the selection color frames it.
    -->
    <Style Selector="TextBox.textEditor">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{DynamicResource SelectionOutlineBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectedItemBrush}" />
    </Style>
    <Style Selector="TextBox.textEditor /template/ Border#PART_BorderElement, TextBox.textEditor:pointerover /template/ Border#PART_BorderElement, TextBox.textEditor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.textEditorFrame">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SelectionOutlineBrush}" />
    </Style>

    <!--
        Touch: the tablet layout has the class "touch" on its root. Every control of these types below it is at least 48 dp high. Rules like this
        come last in the file, so they win over the sizes set above. The desktop has no such class and is not affected.
    -->
    <Style Selector=".touch Button, .touch ToggleButton, .touch DropDownButton, .touch CheckBox, .touch TextBox, .touch ComboBox, .touch MenuItem, .touch ListBoxItem, .touch TabItem, .touch Slider">
        <Setter Property="MinHeight" Value="{DynamicResource TouchTargetSize}" />
    </Style>
    <Style Selector=".touch TextBox.textEditor">
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!--
        The ring context menu (Controls/RingMenuControl). The control makes a Path per wedge and sets the classes hovered, focused and unavailable.
        An unavailable wedge keeps its place and its fill and only dims its icon, so it does not light up under the pointer.
    -->
    <Style Selector="Path.ringWedge">
        <Setter Property="Fill" Value="{DynamicResource RingWedgeBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource RingWedgeOutlineBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Path.ringWedge.hovered">
        <Setter Property="Fill" Value="{DynamicResource RingWedgeHoverBrush}" />
    </Style>
    <Style Selector="Path.ringWedge.focused">
        <Setter Property="Fill" Value="{DynamicResource RingWedgeFocusBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource SelectionOutlineBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="Path.ringWedge.unavailable.hovered">
        <Setter Property="Fill" Value="{DynamicResource RingWedgeBrush}" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon.ringIcon">
        <Setter Property="Foreground" Value="{DynamicResource RingIconBrush}" />
        <Setter Property="Width" Value="{DynamicResource RingIconSize}" />
        <Setter Property="Height" Value="{DynamicResource RingIconSize}" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon.ringIcon.unavailable">
        <Setter Property="Foreground" Value="{DynamicResource RingIconUnavailableBrush}" />
    </Style>
    <Style Selector="Ellipse.ringCenter">
        <Setter Property="Fill" Value="{DynamicResource RingCenterBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource RingWedgeOutlineBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.ringCenterText">
        <Setter Property="Foreground" Value="{DynamicResource RingIconBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>
