<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The single place for colors, sizes and spacing. Views must use these resources
        (DynamicResource for brushes) and never hardcode colors.
        Values are approximated from docs/mockup and are meant to be adjusted here.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Accent (also drives the Fluent accent colors of built-in controls) -->
            <Color x:Key="SystemAccentColor">#6E4FD6</Color>
            <Color x:Key="SystemAccentColorLight1">#8264E6</Color>
            <Color x:Key="SystemAccentColorLight2">#967BF0</Color>
            <Color x:Key="SystemAccentColorLight3">#AB93F7</Color>
            <Color x:Key="SystemAccentColorDark1">#5C3FC0</Color>
            <Color x:Key="SystemAccentColorDark2">#4C31A8</Color>
            <Color x:Key="SystemAccentColorDark3">#3D2790</Color>
            <SolidColorBrush x:Key="AppAccentBrush">#6E4FD6</SolidColorBrush>
            <SolidColorBrush x:Key="AppAccentForegroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SelectedItemBrush">#4D6E4FD6</SolidColorBrush>

            <!-- Surfaces -->
            <SolidColorBrush x:Key="WindowBackgroundBrush">#1B1B20</SolidColorBrush>
            <SolidColorBrush x:Key="PanelBackgroundBrush">#25252C</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarBackgroundBrush">#202026</SolidColorBrush>
            <SolidColorBrush x:Key="ToolColumnBackgroundBrush">#202026</SolidColorBrush>
            <SolidColorBrush x:Key="CanvasBackgroundBrush">#17171C</SolidColorBrush>
            <SolidColorBrush x:Key="ArtboardFillBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ArtboardBorderBrush">#3A3A45</SolidColorBrush>
            <SolidColorBrush x:Key="SelectionOutlineBrush">#8264E6</SolidColorBrush>
            <SolidColorBrush x:Key="SelectionHandleFillBrush">#FFFFFF</SolidColorBrush>

            <!-- Borders -->
            <SolidColorBrush x:Key="BorderSubtleBrush">#35353F</SolidColorBrush>
            <SolidColorBrush x:Key="BorderStrongBrush">#4A4A57</SolidColorBrush>

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush">#E8E8EE</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondaryBrush">#9A9AA8</SolidColorBrush>
            <SolidColorBrush x:Key="TextDisabledBrush">#5E5E6B</SolidColorBrush>

            <!-- Controls -->
            <SolidColorBrush x:Key="ControlBackgroundBrush">#2D2D36</SolidColorBrush>
            <SolidColorBrush x:Key="ControlHoverBrush">#363642</SolidColorBrush>
            <SolidColorBrush x:Key="ControlPressedBrush">#41414F</SolidColorBrush>

            <!-- Rulers -->
            <SolidColorBrush x:Key="RulerBackgroundBrush">#25252C</SolidColorBrush>
            <SolidColorBrush x:Key="RulerTickBrush">#7A7A88</SolidColorBrush>
            <SolidColorBrush x:Key="RulerTextBrush">#A0A0AE</SolidColorBrush>

            <!-- Grid and snap guide lines on the canvas -->
            <SolidColorBrush x:Key="GridLineBrush">#40A0A0B0</SolidColorBrush>
            <SolidColorBrush x:Key="SnapGuideBrush">#FF4FB3</SolidColorBrush>

            <!-- Ruler guides and the markers of the smart guides -->
            <SolidColorBrush x:Key="RulerGuideBrush">#4FC3E8</SolidColorBrush>
            <SolidColorBrush x:Key="RulerGuideSelectedBrush">#F5A524</SolidColorBrush>
            <SolidColorBrush x:Key="RulerGuideActiveBrush">#FF4FB3</SolidColorBrush>
            <SolidColorBrush x:Key="SmartGuideBrush">#FF6AC1</SolidColorBrush>
            <SolidColorBrush x:Key="SmartGuideTextBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SmartGuideLabelBackgroundBrush">#C2185B</SolidColorBrush>

            <!-- Dims the layout behind a message dialog -->
            <SolidColorBrush x:Key="ScrimBrush">#99000000</SolidColorBrush>

            <!-- Text of an input error, such as an invalid grid spacing -->
            <SolidColorBrush x:Key="ErrorTextBrush">#FF7A7A</SolidColorBrush>

            <!-- Ring context menu: wedges, the center disc and the icons. Slightly see-through, so the drawing stays readable behind it. -->
            <SolidColorBrush x:Key="RingWedgeBrush">#F025252C</SolidColorBrush>
            <SolidColorBrush x:Key="RingWedgeHoverBrush">#F0363642</SolidColorBrush>
            <SolidColorBrush x:Key="RingWedgeFocusBrush">#F03D3566</SolidColorBrush>
            <SolidColorBrush x:Key="RingWedgeOutlineBrush">#4A4A57</SolidColorBrush>
            <SolidColorBrush x:Key="RingCenterBrush">#F0202026</SolidColorBrush>
            <SolidColorBrush x:Key="RingIconBrush">#E8E8EE</SolidColorBrush>
            <SolidColorBrush x:Key="RingIconUnavailableBrush">#5E5E6B</SolidColorBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Accent (also drives the Fluent accent colors of built-in controls) -->
            <Color x:Key="SystemAccentColor">#5B3FC2</Color>
            <Color x:Key="SystemAccentColorLight1">#6E4FD6</Color>
            <Color x:Key="SystemAccentColorLight2">#8264E6</Color>
            <Color x:Key="SystemAccentColorLight3">#967BF0</Color>
            <Color x:Key="SystemAccentColorDark1">#4C31A8</Color>
            <Color x:Key="SystemAccentColorDark2">#3D2790</Color>
            <Color x:Key="SystemAccentColorDark3">#2F1D78</Color>
            <SolidColorBrush x:Key="AppAccentBrush">#5B3FC2</SolidColorBrush>
            <SolidColorBrush x:Key="AppAccentForegroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SelectedItemBrush">#335B3FC2</SolidColorBrush>

            <!-- Surfaces -->
            <SolidColorBrush x:Key="WindowBackgroundBrush">#F3F3F6</SolidColorBrush>
            <SolidColorBrush x:Key="PanelBackgroundBrush">#F7F7FA</SolidColorBrush>
            <SolidColorBrush x:Key="ToolbarBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ToolColumnBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CanvasBackgroundBrush">#D9D9E0</SolidColorBrush>
            <SolidColorBrush x:Key="ArtboardFillBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ArtboardBorderBrush">#B8B8C4</SolidColorBrush>
            <SolidColorBrush x:Key="SelectionOutlineBrush">#5B3FC2</SolidColorBrush>
            <SolidColorBrush x:Key="SelectionHandleFillBrush">#FFFFFF</SolidColorBrush>

            <!-- Borders -->
            <SolidColorBrush x:Key="BorderSubtleBrush">#D5D5DE</SolidColorBrush>
            <SolidColorBrush x:Key="BorderStrongBrush">#B4B4C2</SolidColorBrush>

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush">#1E1E26</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondaryBrush">#5E5E6E</SolidColorBrush>
            <SolidColorBrush x:Key="TextDisabledBrush">#A8A8B5</SolidColorBrush>

            <!-- Controls -->
            <SolidColorBrush x:Key="ControlBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ControlHoverBrush">#ECECF2</SolidColorBrush>
            <SolidColorBrush x:Key="ControlPressedBrush">#E0E0E8</SolidColorBrush>

            <!-- Rulers -->
            <SolidColorBrush x:Key="RulerBackgroundBrush">#F7F7FA</SolidColorBrush>
            <SolidColorBrush x:Key="RulerTickBrush">#7A7A88</SolidColorBrush>
            <SolidColorBrush x:Key="RulerTextBrush">#4F4F5E</SolidColorBrush>

            <!-- Grid and snap guide lines on the canvas -->
            <SolidColorBrush x:Key="GridLineBrush">#40606070</SolidColorBrush>
            <SolidColorBrush x:Key="SnapGuideBrush">#E0208A</SolidColorBrush>

            <!-- Ruler guides and the markers of the smart guides -->
            <SolidColorBrush x:Key="RulerGuideBrush">#19A7CE</SolidColorBrush>
            <SolidColorBrush x:Key="RulerGuideSelectedBrush">#E08A00</SolidColorBrush>
            <SolidColorBrush x:Key="RulerGuideActiveBrush">#E0208A</SolidColorBrush>
            <SolidColorBrush x:Key="SmartGuideBrush">#C2185B</SolidColorBrush>
            <SolidColorBrush x:Key="SmartGuideTextBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SmartGuideLabelBackgroundBrush">#C2185B</SolidColorBrush>

            <!-- Dims the layout behind a message dialog -->
            <SolidColorBrush x:Key="ScrimBrush">#66000000</SolidColorBrush>

            <!-- Text of an input error, such as an invalid grid spacing -->
            <SolidColorBrush x:Key="ErrorTextBrush">#C62828</SolidColorBrush>

            <!-- Ring context menu: wedges, the center disc and the icons. Slightly see-through, so the drawing stays readable behind it. -->
            <SolidColorBrush x:Key="RingWedgeBrush">#F0F7F7FA</SolidColorBrush>
            <SolidColorBrush x:Key="RingWedgeHoverBrush">#F0E4E4EC</SolidColorBrush>
            <SolidColorBrush x:Key="RingWedgeFocusBrush">#F0DCD3F5</SolidColorBrush>
            <SolidColorBrush x:Key="RingWedgeOutlineBrush">#B4B4C2</SolidColorBrush>
            <SolidColorBrush x:Key="RingCenterBrush">#F0FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="RingIconBrush">#1E1E26</SolidColorBrush>
            <SolidColorBrush x:Key="RingIconUnavailableBrush">#A8A8B5</SolidColorBrush>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Sizes and spacing (same in both themes) -->
    <x:Double x:Key="ToolButtonSize">36</x:Double>
    <x:Double x:Key="ToolbarButtonSize">32</x:Double>
    <x:Double x:Key="ToolbarHeight">48</x:Double>
    <x:Double x:Key="StatusBarHeight">28</x:Double>
    <x:Double x:Key="RulerSize">20</x:Double>
    <x:Double x:Key="FieldHeight">28</x:Double>
    <x:Double x:Key="PanelSpacing">8</x:Double>
    <x:Double x:Key="SettingsCategoryListWidth">200</x:Double>
    <x:Double x:Key="SettingsFieldWidth">160</x:Double>
    <Thickness x:Key="SettingsPagePadding">20</Thickness>
    <x:Double x:Key="SettingsRowSpacing">12</x:Double>
    <x:Double x:Key="UiFontSize">13</x:Double>
    <x:Double x:Key="SectionHeaderFontSize">14</x:Double>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <Thickness x:Key="PanelPadding">8</Thickness>

    <!-- Tool column. The swatch area holds the fill and stroke swatches with the swap and reset buttons in its four corners. -->
    <x:Double x:Key="ToolIconSize">20</x:Double>
    <Thickness x:Key="ToolButtonMargin">2</Thickness>
    <Thickness x:Key="ToolColumnPadding">4,6</Thickness>
    <x:Double x:Key="SwatchAreaWidth">44</x:Double>
    <x:Double x:Key="SwatchAreaHeight">56</x:Double>
    <Thickness x:Key="SwatchAreaMargin">0,8,0,4</Thickness>
    <x:Double x:Key="SwatchSize">26</x:Double>
    <x:Double x:Key="SwatchButtonSize">20</x:Double>
    <x:Double x:Key="SwatchIconSize">12</x:Double>

    <!-- The tablet tool column: the corner mark of a tool group, and the height of an entry in a group's flyout. -->
    <x:Double x:Key="ToolGroupMarkSize">7</x:Double>
    <!-- The tablet color swatch at the bottom of the tool column: the stroke ring and the fill square inside it (the button around it is 48 dp). -->
    <x:Double x:Key="ColorSwatchRingSize">40</x:Double>
    <x:Double x:Key="ColorSwatchFillSize">22</x:Double>
    <x:Double x:Key="ToolFlyoutItemHeight">36</x:Double>

    <!-- Panels: icon size, the color chips of the Properties panel, and the smallest tappable size that a chip button has. -->
    <x:Double x:Key="PanelIconSize">18</x:Double>
    <x:Double x:Key="PropertySwatchWidth">52</x:Double>
    <x:Double x:Key="PropertySwatchHeight">24</x:Double>
    <x:Double x:Key="SmallSwatchSize">20</x:Double>
    <x:Double x:Key="SwatchButtonMinSize">0</x:Double>

    <!-- Rows of the Layers and History lists: row height, the lock and visibility buttons in a row, and the icons. -->
    <x:Double x:Key="LayerRowMinHeight">30</x:Double>
    <x:Double x:Key="HistoryRowMinHeight">28</x:Double>
    <x:Double x:Key="RowButtonSize">28</x:Double>
    <x:Double x:Key="RowIconSize">16</x:Double>

    <!-- How far a row of the Layers list moves to the right for each level of layer and group above it. -->
    <x:Double x:Key="RowIndentSize">14</x:Double>

    <!-- Selection handles on the canvas: the side they are drawn with. The area that grabs a handle for a finger is TouchHandleGrabSize (only the tablet layout uses it). -->
    <x:Double x:Key="SelectionHandleSize">8</x:Double>
    <x:Double x:Key="TouchHandleGrabSize">44</x:Double>

    <!-- The opacity of the shapes that are outside the group that was entered. The group and its shapes keep full strength. -->
    <x:Double x:Key="EnteredGroupDimOpacity">0.35</x:Double>

    <!-- The most height a menu that opens from the toolbar may have. A longer menu scrolls (the overflow menu and the zoom list do not fit the screen at 48 dp per row). -->
    <x:Double x:Key="FlyoutMaxHeight">520</x:Double>

    <!-- The ring context menu: the outer and the inner radius of the wedges (the inner one is the center disc) and the icon size. -->
    <x:Double x:Key="RingOuterRadius">110</x:Double>
    <x:Double x:Key="RingInnerRadius">34</x:Double>
    <x:Double x:Key="RingIconSize">22</x:Double>
    <!-- The width of the panel that floats over the canvas in the tablet layout. -->
    <x:Double x:Key="TabletPanelWidth">340</x:Double>

    <!-- The smallest height of a button, check box, text box or slider under a control with the class "touch" (the tablet layout). 48 dp. -->
    <x:Double x:Key="TouchTargetSize">48</x:Double>

    <!--
        Sizes for touch and stylus (the tablet layout). The layout copies this dictionary into its own resources (Controls/TouchSizes.cs), so everything under it that looks
        its sizes up with DynamicResource gets these values, and the desktop layout keeps the ones above. Every interactive control is at least 48 dp.
        A key has to exist above too, so that the desktop has a value (a test checks this).
    -->
    <ResourceDictionary x:Key="TouchSizes">
        <x:Double x:Key="ToolButtonSize">48</x:Double>
        <x:Double x:Key="ToolbarButtonSize">48</x:Double>
        <x:Double x:Key="ToolIconSize">28</x:Double>
        <Thickness x:Key="ToolButtonMargin">4</Thickness>
        <Thickness x:Key="ToolColumnPadding">4,8</Thickness>
        <x:Double x:Key="ToolFlyoutItemHeight">48</x:Double>
        <x:Double x:Key="FieldHeight">48</x:Double>
        <x:Double x:Key="UiFontSize">15</x:Double>
        <x:Double x:Key="SectionHeaderFontSize">16</x:Double>
        <x:Double x:Key="PanelIconSize">24</x:Double>
        <x:Double x:Key="PropertySwatchWidth">96</x:Double>
        <x:Double x:Key="PropertySwatchHeight">48</x:Double>
        <x:Double x:Key="SmallSwatchSize">28</x:Double>
        <x:Double x:Key="SwatchButtonMinSize">48</x:Double>
        <x:Double x:Key="LayerRowMinHeight">48</x:Double>
        <x:Double x:Key="HistoryRowMinHeight">48</x:Double>
        <x:Double x:Key="RowButtonSize">48</x:Double>
        <x:Double x:Key="RowIconSize">22</x:Double>
        <x:Double x:Key="RowIndentSize">24</x:Double>
        <x:Double x:Key="SelectionHandleSize">18</x:Double>
        <x:Double x:Key="ToolbarHeight">56</x:Double>
        <x:Double x:Key="StatusBarHeight">48</x:Double>
        <x:Double x:Key="RingOuterRadius">150</x:Double>
        <x:Double x:Key="RingInnerRadius">44</x:Double>
        <x:Double x:Key="RingIconSize">30</x:Double>
    </ResourceDictionary>
</ResourceDictionary>
